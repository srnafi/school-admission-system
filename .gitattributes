# Normalize line endings so Linux containers never see CRLF
# (a CRLF `docker-entrypoint.sh` fails with "/bin/sh^M: bad interpreter").
* text=auto eol=lf

*.sh              text eol=lf
Dockerfile        text eol=lf
*.cs              text eol=lf
*.csproj          text eol=lf
*.sln             text eol=lf
*.json            text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.ts              text eol=lf
*.tsx             text eol=lf
*.conf            text eol=lf

*.ps1             text eol=crlf
*.bat             text eol=crlf
*.cmd             text eol=crlf

*.png             binary
*.jpg             binary
*.ico             binary
